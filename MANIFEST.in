include LICENSE README.md CHANGELOG.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md DEVELOPMENT_STATUS.md
recursive-include tests *.py *.json
recursive-include docs *.md
recursive-include policies *.md
recursive-include scripts *.py *.ps1 *.sh
prune .uds
prune .venv
prune dist
global-exclude __pycache__ *.py[cod]
